{
  "renderer": "Chrome SwiftShader via --use-gl=angle --use-angle=swiftshader",
  "viewport": "1440x900 unless noted",
  "input": "Playwright mouse.click at control center, not element.click()",
  "tide_then_two": {
    "second_hit": "BUTTON[data-gear-toggle]",
    "during": "data-phase=surge",
    "after": "data-gear=two data-phase=retarget",
    "flash_opacity": "0",
    "hero_hit": "DIV#figure"
  },
  "retarget_two_to_tide": {
    "hit": "BUTTON[data-gear-blue]",
    "after_40ms": "data-gear=blue"
  },
  "phone_390": {
    "hits": ["BUTTON:blue", "BUTTON:two"],
    "note": "Second press reached the button. Palette waits for the 90ms Gear Two acknowledgment when leaving neutral."
  },
  "reduced_os": {
    "gear": "blue",
    "phase": null,
    "motion": "reduced"
  },
  "saved_tide_reload": {
    "gear": "blue",
    "pressed": ["false", "true"],
    "ring": "present in tide-reload.jpg"
  },
  "not_measured": ["hardware GPU frame time", "Safari", "physical phone"]
}
